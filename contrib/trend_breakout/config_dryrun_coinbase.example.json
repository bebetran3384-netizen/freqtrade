{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "trendbreakout-coinbase-dryrun",
    "strategy": "TrendBreakoutStrategy",
    "timeframe": "6h",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "max_open_trades": 5,
    "stake_currency": "USD",
    "stake_amount": 100,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "db_url": "sqlite:///user_data/dryrun_trendbreakout_coinbase.sqlite",
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": false,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": false,
        "order_book_top": 1
    },
    "exchange": {
        "name": "coinbase",
        "secret": "",
        "pair_whitelist": [
            "BTC/USD",
            "ETH/USD",
            "SOL/USD",
            "XRP/USD",
            "BNB/USD",
            "DOGE/USD",
            "ADA/USD",
            "AVAX/USD",
            "LINK/USD",
            "DOT/USD",
            "LTC/USD",
            "BCH/USD",
            "NEAR/USD",
            "UNI/USD"
        ],
        "pair_blacklist": [],
        "key": ""
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },
    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8081,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "CHANGE_ME_to_a_long_random_string",
        "ws_token": "CHANGE_ME_to_a_long_random_string",
        "CORS_origins": [],
        "username": "freqtrader",
        "password": "CHANGE_ME_to_a_long_random_string"
    },
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    }
}
